# Copiar a .env.production (NUNCA commitear .env.production - esta en .gitignore)
# Requerido por docker-compose.prod.yml (services db, backend, celery_worker)

# Django
# CRITICO: sin DJANGO_SETTINGS_MODULE, wsgi.py/celery.py usan config.settings.development
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=cambiar-por-clave-secreta-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=misitio.com,www.misitio.com

# PostgreSQL (servicio db del compose; mantener password sincronizado con DATABASE_URL)
POSTGRES_DB=eurocar_prod
POSTGRES_USER=eurocar
POSTGRES_PASSWORD=cambiar-por-password-fuerte
DATABASE_URL=postgres://eurocar:cambiar-por-password-fuerte@db:5432/eurocar_prod

# Redis (opcional: sin REDIS_URL, production.py degrada a locmem + Celery eager)
REDIS_URL=redis://redis:6379/0

# Email SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=micuenta@gmail.com
EMAIL_HOST_PASSWORD=clave-de-aplicacion
DEFAULT_FROM_EMAIL=R Car Rogil <micuenta@gmail.com>

# Media S3/R2 (opcional: activa S3Storage en production.py)
# AWS_STORAGE_BUCKET_NAME=eurocar
# AWS_S3_ACCESS_KEY_ID=...
# AWS_S3_SECRET_ACCESS_KEY=...
# AWS_S3_ENDPOINT_URL=https://<id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=pub-<hash>.r2.dev
