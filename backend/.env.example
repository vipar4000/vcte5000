# Plantilla de backend/.env para desarrollo local.
# Copiar a backend/.env (git lo ignora) y ajustar los valores.
# En producción NO se usa este archivo: Render inyecta las variables de entorno.

DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True

# Base de datos (opcional en desarrollo: sin DATABASE_URL se usa SQLite)
# DATABASE_URL=postgresql://eurocar:mi-clave-local-segura@localhost:5432/eurocar

# Redis y Celery (opcionales en desarrollo)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
